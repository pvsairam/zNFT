# Private key for deployment (DO NOT commit the actual .env file)
PRIVATE_KEY=your_private_key_here

# RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ZAMA_SEPOLIA_RPC_URL=https://devnet.zama.ai

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Gas reporting
REPORT_GAS=false

# Gateway configuration
GATEWAY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
KMS_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
